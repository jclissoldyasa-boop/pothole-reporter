{
  // The app's website. Deploy: server/node_modules/.bin/wrangler deploy (from this folder).
  // The map server is separate, in server/.
  "$schema": "server/node_modules/wrangler/config-schema.json",
  "name": "motopotholereporter-site",
  "main": "site-worker.js",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": ".", "binding": "ASSETS", "run_worker_first": true },
  "workers_dev": false,
  "routes": [
    { "pattern": "motopotholereporter.au", "custom_domain": true },
    { "pattern": "www.motopotholereporter.au", "custom_domain": true }
  ]
}
